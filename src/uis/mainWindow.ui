<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <!-- 이 파일은 배치를 정하지 않는다. 패널 내용을 선언하는 자리다.

      좌측(탐색기·요약)과 하단(진단·로그·검색)은 Qt ADS 의 도크 위젯으로 들어가고,
      실제 배치는 MainWindow::setupDockLayout() 이 만든다. 그래서 여기서는 패널마다
      pnl* 컨테이너를 하나씩 세로로 늘어놓기만 한다 — Designer 로 열면 앱과 닮지
      않은 세로 목록으로 보이는데, 그것이 정상이다. setupDockLayout() 이 이 컨테이너
      들을 각자의 도크로 옮기고 나면 centralwidget 의 레이아웃에는 도크 매니저만
      남는다.

      pnl* 컨테이너를 C++ 로 만들지 않고 여기 두는 이유: 잎 위젯(treOutlineDocument
      등)의 이름과 속성을 한곳에서 관리해야 MainWindow.cpp 의 Ui.* 참조 25 곳이
      그대로 살아 있고, 트리 헤더 설정 같은 것을 Designer 에서 계속 볼 수 있다. -->
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1246</width>
    <height>932</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string notr="true">MultiRoot reST Editor</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="centralLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <property name="spacing">
     <number>0</number>
    </property>
    <item>
     <!-- 중앙 도크의 내용. 편집기 | 프리뷰 스플리터는 도킹으로 옮기지 않는다 —
          QWebEngineView 를 떼어내 별도 창으로 띄우는 경로를 만들지 않기 위해서다. -->
     <widget class="QFrame" name="frmContents">
      <property name="frameShape">
       <enum>QFrame::Shape::StyledPanel</enum>
      </property>
      <property name="frameShadow">
       <enum>QFrame::Shadow::Raised</enum>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout_7">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QSplitter" name="splitter_2">
         <property name="orientation">
          <enum>Qt::Orientation::Horizontal</enum>
         </property>
         <widget class="QFrame" name="frmEditor">
          <property name="frameShape">
           <enum>QFrame::Shape::NoFrame</enum>
          </property>
          <property name="frameShadow">
           <enum>QFrame::Shadow::Plain</enum>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_5">
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <widget class="QTabWidget" name="tabEditor"/>
           </item>
          </layout>
         </widget>
         <widget class="QFrame" name="frmWebPreview">
          <property name="frameShape">
           <enum>QFrame::Shape::NoFrame</enum>
          </property>
          <property name="frameShadow">
           <enum>QFrame::Shadow::Plain</enum>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_6">
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <!-- url 속성을 두지 않는다. uic 가 그것을 setProperty("url", ...) 로
                 펼치고, 그것이 QWebEngineView::setUrl() -> page() 생성 -> Chromium
                 부팅으로 이어진다. 즉 setupUi() 안에서 Chromium 이 통째로 뜬다
                 (실측 424~1254ms). 그 시점은 첫 프레임보다 앞이라 그동안 창이
                 아무것도 그리지 못한다. 페이지 생성은 MainWindow 가 첫 페인트
                 뒤에 명시적으로 한다(initialisePreview). -->
            <widget class="QWebEngineView" name="webEngineView" native="true"/>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <!-- 좌측 위 도크: 탐색기 -->
     <widget class="QWidget" name="pnlFolderTree" native="true">
      <layout class="QVBoxLayout" name="pnlFolderTreeLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <!-- 필터 + 파일 조작. 글자와 도구 설명은 코드에서 넣는다(번역 대상). -->
        <layout class="QHBoxLayout" name="pnlFolderTreeToolRow">
         <property name="spacing">
          <number>2</number>
         </property>
         <property name="leftMargin">
          <number>3</number>
         </property>
         <property name="topMargin">
          <number>3</number>
         </property>
         <property name="rightMargin">
          <number>3</number>
         </property>
         <property name="bottomMargin">
          <number>1</number>
         </property>
         <item>
          <widget class="QLineEdit" name="edtExplorerFilter">
           <property name="clearButtonEnabled">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <!-- 단추 묶음. 필터칸이 포커스를 받으면 이 묶음이 접히면서 입력칸이
               줄 전체를 쓴다(MainWindow::setExplorerActionsCollapsed). 낱개로
               접으면 애니메이션이 다섯 개가 되고 간격이 따로 놀아 한 덩어리로
               묶어 두었다. -->
          <widget class="QWidget" name="pnlExplorerActions" native="true">
           <layout class="QHBoxLayout" name="pnlExplorerActionsLayout">
            <property name="spacing">
             <number>2</number>
            </property>
            <property name="leftMargin">
             <number>0</number>
            </property>
            <property name="topMargin">
             <number>0</number>
            </property>
            <property name="rightMargin">
             <number>0</number>
            </property>
            <property name="bottomMargin">
             <number>0</number>
            </property>
            <item>
             <widget class="QToolButton" name="btnExplorerShowAll">
              <property name="autoRaise">
               <bool>true</bool>
              </property>
              <property name="checkable">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btnExplorerNewFile">
              <property name="autoRaise">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btnExplorerNewFolder">
              <property name="autoRaise">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btnExplorerRename">
              <property name="autoRaise">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btnExplorerDelete">
              <property name="autoRaise">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QTreeView" name="treLeftSideFolterTree">
         <property name="contextMenuPolicy">
          <enum>Qt::CustomContextMenu</enum>
         </property>
         <property name="indentation">
          <number>15</number>
         </property>
         <attribute name="headerCascadingSectionResizes">
          <bool>true</bool>
         </attribute>
         <attribute name="headerShowSortIndicator" stdset="0">
          <bool>true</bool>
         </attribute>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <!-- 좌측 아래 도크: 요약(활성 문서) -->
     <widget class="QWidget" name="pnlOutlineDocument" native="true">
      <layout class="QVBoxLayout" name="pnlOutlineDocumentLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QLineEdit" name="edtOutlineDocumentFilter">
         <property name="clearButtonEnabled">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QTreeWidget" name="treOutlineDocument">
         <column>
          <property name="text">
           <string notr="true">1</string>
          </property>
         </column>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <!-- 좌측 아래 도크: 요약(프로젝트). 활성 문서와 같은 자리에 탭으로 붙는다. -->
     <widget class="QWidget" name="pnlOutlineProject" native="true">
      <layout class="QVBoxLayout" name="pnlOutlineProjectLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QLineEdit" name="edtOutlineProjectFilter">
         <property name="clearButtonEnabled">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QTreeWidget" name="treOutlineProject">
         <column>
          <property name="text">
           <string notr="true">1</string>
          </property>
         </column>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <!-- 하단 도크: 진단 -->
     <widget class="QWidget" name="pnlDiagnostics" native="true">
      <layout class="QVBoxLayout" name="pnlDiagnosticsLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QTableWidget" name="tblDiagnostics"/>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <!-- 하단 도크: 로그 -->
     <widget class="QWidget" name="pnlLog" native="true">
      <layout class="QVBoxLayout" name="pnlLogLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QPlainTextEdit" name="logView">
         <!-- 읽기 전용이 아니면 로그 창에 글자를 칠 수 있다. 눌러서 고쳐지는
              기록은 기록이 아니다. -->
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <!-- 상한이 없으면 Sphinx 빌드 경고가 그대로 쌓인다. 이 저장소의
              Breathe 프로젝트는 한 빌드가 진단 2000건(파이썬 쪽 MAX_DIAGNOSTICS)
              까지 내고, 그 위에 빌더 표준출력 전량이 얹힌다. 블록마다 문서
              레이아웃이 붙으므로 무제한은 메모리와 스크롤 양쪽에서 값을 치른다.
              5000줄이면 한 빌드의 출력을 통째로 담고도 남는다. -->
         <property name="maximumBlockCount">
          <number>5000</number>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
   </layout>
